# Local .terraform directories
.terraform/

# State files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Plan output files
*.tfplan
tfplan

# CLI config
.terraformrc
terraform.rc

# Note: .terraform.lock.hcl is intentionally committed.
